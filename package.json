{
	"name": "@furnas-technology/timeline",
	"version": "0.0.0",
	"description": "Framework-free, canvas-rendered hierarchical timeline (Gantt/flowchart) with lane packing, sub-totals, per-period totals and broadcast/Gregorian calendars. Strict TypeScript, Luxon dates.",
	"license": "MIT",
	"author": {
		"name": "Furnas Technology",
		"email": "info@furnas.technology",
		"url": "https://github.com/furnas-technology"
	},
	"homepage": "https://github.com/furnas-technology/timeline#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/furnas-technology/timeline.git"
	},
	"bugs": {
		"url": "https://github.com/furnas-technology/timeline/issues"
	},
	"keywords": [
		"timeline",
		"gantt",
		"flowchart",
		"media-plan",
		"canvas",
		"broadcast-calendar",
		"luxon",
		"typescript",
		"subtotals",
		"framework-agnostic"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup",
		"dev": "vite examples",
		"build:examples": "vite build examples --outDir ../site --emptyOutDir",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit && tsc --noEmit -p examples",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check:pkg": "publint --strict && attw --pack . --profile node16",
		"docs": "typedoc",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:pkg",
		"release": "npm run build && changeset publish"
	},
	"peerDependencies": {
		"luxon": "^3.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.6.4",
		"@changesets/cli": "^3.0.3",
		"@napi-rs/canvas": "^1.0.13",
		"@types/luxon": "^3.7.6",
		"@vitest/coverage-v8": "^5.0.5",
		"jsdom": "^30.1.3",
		"luxon": "^3.7.2",
		"publint": "^0.3.25",
		"tsup": "^9.0.0",
		"typedoc": "^0.28.20",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
